{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{ printf "<rss version=\"2.0\" xmlns:atom=\"http://www.w3.org/2005/Atom\">" | safeHTML }}
    <channel>
        {{- range site.Pages }}
        {{- if .Params.layout }}
        <item>
            <title>
                {{- .Title | htmlEscape }}
                {{- with .Params.subtitle -}}
                    {{ printf " (%s)" (delimit . " | ") }}
                {{- end -}}
            </title>
            <breadcrumb>
                {{- $titles := slice -}}
                {{- range .Ancestors.Reverse -}}
                    {{- if and (not (eq .RelPermalink "/")) (not (eq .RelPermalink (printf "/%s/" (.Site.Params.docs.pathName | default "docs")))) }}
                        {{- $titles = $titles | append .Title -}}
                    {{- end -}}
                {{- end -}}
                {{- $titles = $titles | append .Title -}}
                {{- delimit $titles " / " -}}
            </breadcrumb>
            <content>{{ .Content | htmlEscape | replaceRE "\r?\n" "&#xA;" | safeHTML }}</content>
            <url>{{ .Permalink }}</url>
            <icon>{{ .Params.icon }}</icon>
            <author>
                {{- if eq .Params.layout "song-view" -}}
                    {{- if eq .Parent.Params.layout "album-view" -}}
                        {{- .Parent.Parent.Title }}
                        {{- with .Parent.Parent.Params.subtitle -}}
                            {{ printf " (%s)" (delimit . " | ") }}
                        {{- end -}}
                    {{- else -}}
                        {{- .Parent.Title }}
                        {{- with .Parent.Params.subtitle -}}
                            {{ printf " (%s)" (delimit . " | ") }}
                        {{- end -}}
                    {{- end -}}
                {{- else if eq .Params.layout "album-view" -}}
                    {{- .Parent.Title }}
                    {{- with .Parent.Params.subtitle -}}
                        {{ printf " (%s)" (delimit . " | ") }}
                    {{- end -}}
                {{- else if eq .Params.layout "artist-view" -}}
                    {{- .Title }}
                    {{- with .Params.subtitle -}}
                        {{ printf " (%s)" (delimit . " | ") }}
                    {{- end -}}
                {{- end -}}
            </author>
        </item>
        {{- end }}
        {{- end }}
    </channel>
</rss>
