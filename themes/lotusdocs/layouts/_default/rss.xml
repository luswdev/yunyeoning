{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{ printf "<rss version=\"2.0\" xmlns:atom=\"http://www.w3.org/2005/Atom\">" | safeHTML }}
    <channel>
        <title>{{ site.Title }}</title>
        <link>{{ site.BaseURL }}</link>
        <description>{{ site.Home.Description }}</description>
        <generator>Hugo</generator>
        <language>zh-TW</language>
        <lastBuildDate>
            {{- $pages := site.RegularPages.ByLastmod.Reverse -}}
            {{- with index $pages 0 -}}
                {{- .Lastmod.Format "2006-01-02T15:04:05" -}}
            {{- end -}}
        </lastBuildDate>
        <atom:link href="{{ "index.xml" | absURL }}" rel="self" type="application/atom+xml"/>
        {{- range site.Pages }}
        {{- if .Params.layout }}
        <item>
            <title>
                {{- .Title | htmlEscape }}
                {{- with .Params.subtitle -}}
                    {{ printf " (%s)" (delimit . " | ") }}
                {{- end -}}
            </title>
            <link>{{ .Permalink }}</link>
            <guid>{{ .Permalink }}</guid>
            <breadcrumb>
                {{- $titles := slice -}}
                {{- range .Ancestors.Reverse -}}
                    {{- if and (not (eq .RelPermalink "/")) (not (eq .RelPermalink (printf "/%s/" (.Site.Params.docs.pathName | default "docs")))) }}
                        {{- $title := .Title -}}
                        {{- with .Params.subtitle -}}
                            {{ $title = printf "%s (%s)" $title (delimit . " | ") }}
                        {{- end -}}
                        {{- $titles = $titles | append $title -}}
                    {{- end -}}
                {{- end -}}
                {{- $title := .Title -}}
                {{- with .Params.subtitle -}}
                    {{ $title = printf "%s (%s)" $title (delimit . " | ") }}
                {{- end -}}
                {{- $titles = $titles | append $title -}}
                {{- printf "/ %s" (delimit $titles " / ") -}}
            </breadcrumb>
            <content>{{ .Content | htmlEscape | replaceRE "\r?\n" "&#xA;" | safeHTML }}</content>
            <icon>{{ .Params.icon }}</icon>
            <author>
                {{- if eq .Params.layout "song-view" -}}
                    {{- if eq .Parent.Params.layout "album-view" -}}
                        {{- .Parent.Parent.Title }}
                        {{- with .Parent.Parent.Params.subtitle -}}
                            {{ printf " (%s)" (delimit . " | ") }}
                        {{- end -}}
                    {{- else -}}
                        {{- .Parent.Title }}
                        {{- with .Parent.Params.subtitle -}}
                            {{ printf " (%s)" (delimit . " | ") }}
                        {{- end -}}
                    {{- end -}}
                {{- else if eq .Params.layout "album-view" -}}
                    {{- .Parent.Title }}
                    {{- with .Parent.Params.subtitle -}}
                        {{ printf " (%s)" (delimit . " | ") }}
                    {{- end -}}
                {{- else if eq .Params.layout "artist-view" -}}
                    {{- .Title }}
                    {{- with .Params.subtitle -}}
                        {{ printf " (%s)" (delimit . " | ") }}
                    {{- end -}}
                {{- end -}}
            </author>
        </item>
        {{- end }}
        {{- end }}
    </channel>
</rss>
